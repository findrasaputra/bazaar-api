PORT=8080
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=bazaar
DB_PASSWORD=changeme
DB_NAME=bazaar

# Legacy admin tokens. Needs 32+ random characters: openssl rand -hex 32
# Left empty or weak, legacy admin tokens are rejected.
JWT_SECRET=
# Keycloak admin logins (all three required)
OIDC_BASE_URL=http://localhost:8180
OIDC_REALM=bazaar-admin
OIDC_CLIENT_ID=bazaar-admin-portal

AUTH_SERVICE_URL=http://localhost:9000/auth
# Optional: this API's own credentials for token introspection
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
# Optional: comma-separated app client ids whose tokens are accepted
AUTH_ALLOWED_CLIENT_IDS=
CATALOG_URL=http://localhost:9000/catalog
CATALOG_KEY=changeme
CATALOG_SECRET=changeme
# Secret configured on the catalog's webhooks; unsigned webhooks are rejected
CATALOG_WEBHOOK_SECRET=

SPACES_ENDPOINT=http://localhost:9001
SPACES_REGION=us-east-1
SPACES_BUCKET=bazaar-assets
SPACES_KEY=changeme
SPACES_SECRET=changeme
SPACES_CDN=http://localhost:9001/bazaar-assets

SMTP_HOST=localhost
SMTP_USER=changeme
SMTP_PASSWORD=changeme

PARTNER_USER=partner
PARTNER_PASS=changeme

JOB_TOKEN=changeme

ORDER_COMPLETE_DAYS=7
BONUS_POINT_VALUE=100
SHIPPING_FEE=5
